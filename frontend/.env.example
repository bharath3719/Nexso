# Frontend environment example
#
# Public URL of the backend API.
# Vite inlines this at BUILD time, not at runtime — it must be set in the build
# environment (e.g. Vercel → Settings → Environment Variables → Production)
# before `npm run build` runs. If it is missing the bundle ships with the
# localhost fallback baked in and every API call fails in production.
VITE_API_BASE=http://localhost:3000

# Local development and preview server overrides
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173
# VITE_ALLOWED_HOSTS=example.ngrok-free.app,localhost

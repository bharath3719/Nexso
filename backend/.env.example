# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=https://your-frontend-domain.com
# Public base URL of this backend (used to build PDF links sent via WhatsApp)
# Must be reachable by Meta's servers — set to your deployed domain, e.g. https://api.yourdomain.com
BACKEND_PUBLIC_URL=

# Set to "true" if running behind nginx / a reverse proxy (e.g. Railway, Render)
TRUST_PROXY=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Preferred: single connection string
DATABASE_URL=postgres://user:password@host:5432/nexso

# Alternative: individual vars (used only when DATABASE_URL is not set)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=nexso

# ── Ticket behaviour ──────────────────────────────────────────────────────────
# Suppress duplicate tickets from the same user within N minutes (default 30)
DEDUP_MINUTES=30
# Auto-assign new tickets to first available APPROVED vendor in the category
AUTO_ASSIGN=true

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_TIMEZONE=Asia/Kolkata

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Meta webhook: verify token + app secret for signature validation
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# Cloud API credentials (Meta for Developers → App → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Fallback reply when no keyword matches (plain-text mode)
WHATSAPP_TEXT_REPLY=Your request has been recorded. We will get back to you shortly.

# URL shown to vendors in "new ticket assigned" WhatsApp messages
VENDOR_PORTAL_URL=https://your-vendor-portal-domain.com

# ── Email / SMTP (maintenance reminders) ──────────────────────────────────────
# Gmail: generate an App Password at myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Nexso Society Management

# ── Payments ──────────────────────────────────────────────────────────────────
# Which rail mints the link stored on each maintenance due:
#   auto     (default) Razorpay when its keys are set, otherwise UPI
#   upi      hosted /pay/:token page → UPI intent link to the society's own VPA.
#            No gateway onboarding, real money into a normal bank account, but
#            the resident declares the UTR and the secretary confirms it.
#   razorpay hosted Razorpay Payment Link, auto-reconciled by webhook.
# The UPI rail additionally needs BACKEND_PUBLIC_URL (above) and a per-society
# UPI ID, set in the app under Maintenance → Save UPI.
PAYMENT_PROVIDER=auto

# ── Razorpay ──────────────────────────────────────────────────────────────────
# API keys: dashboard.razorpay.com → Settings → API Keys
# Webhook secret: Dashboard → Settings → Webhooks → add /webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

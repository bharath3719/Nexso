PORT=3000
NODE_ENV=development

# Required for persistence outside local fallback mode
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Comma-separated allowed frontend origins, leave empty to allow all origins
CORS_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy or load balancer
TRUST_PROXY=false

# WhatsApp / Meta webhook verification
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp outbound messaging
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FLOW_TEMPLATE_NAME=

# Optional JSON string for template components
# WHATSAPP_TEMPLATE_COMPONENTS=[{"type":"body","parameters":[]}]
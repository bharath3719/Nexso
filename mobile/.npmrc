; expo-router@57 pulls vaul/@radix-ui (web-only deps) that still declare React <=18
; peer ranges, while this app is on React 19.2. Without this flag every `npm install`
; and `npx expo install` fails with ERESOLVE. Keep it here rather than passing the
; flag ad hoc — a bare `npm install --legacy-peer-deps` silently pruned
; react-native-reanimated out of the tree once already.
legacy-peer-deps=true
